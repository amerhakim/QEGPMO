generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  ESCALATED
  CANCELLED
}

enum ApprovalDecision {
  APPROVE
  REJECT
  ESCALATE
  AUTO_REJECT
}

enum EscalationAction {
  NOTIFY
  AUTO_ESCALATE
  AUTO_REJECT
}

enum ProjectHealthRag {
  GREEN
  AMBER
  RED
}

enum ProjectLifecycleStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum GateDecision {
  PENDING
  PASSED
  FAILED
}

enum ExcelJobStatus {
  CREATED
  VALIDATED
  COMPLETED
  FAILED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

enum BaselineScope {
  PROJECT
  TASK
}

/// Original baseline vs subsequent rebaseline (MSP-compatible semantics).
enum BaselineKind {
  ORIGINAL
  UPDATED
}

enum ResourceType {
  NAMED
  GENERIC
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum AllocationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum FinancialObjectType {
  PROJECT
  PROGRAM
  PORTFOLIO
  ENTERPRISE
}

enum BudgetCategory {
  CAPEX
  OPEX
}

enum FinancialAlertRag {
  GREEN
  AMBER
  RED
}

enum SeverityLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RecordStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  CLOSED
  ESCALATED
}

enum ActionType {
  MITIGATION
  CONTINGENCY
  CORRECTIVE
}

model WorkflowDefinition {
  id          String           @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?
  entityType  String
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  steps       WorkflowStep[]
  instances   WorkflowInstance[]
  escalations EscalationRule[]

  @@unique([tenantId, code])
  @@index([tenantId, entityType, isActive])
}

model WorkflowStep {
  id                   String              @id @default(uuid())
  workflowDefinitionId String
  code                 String
  name                 String
  sequence             Int
  approverRole         String
  requiredApprovals    Int                 @default(1)
  slaMinutes           Int?
  isFinal              Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  workflowDefinition   WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  approvalActions      ApprovalAction[]
  escalationRules      EscalationRule[]

  @@unique([workflowDefinitionId, code])
  @@unique([workflowDefinitionId, sequence])
}

model WorkflowInstance {
  id                   String                 @id @default(uuid())
  tenantId             String
  workflowDefinitionId String
  entityType           String
  entityId             String
  status               WorkflowInstanceStatus @default(IN_PROGRESS)
  currentStepSequence  Int                    @default(1)
  startedBy            String
  stepStartedAt        DateTime               @default(now())
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  workflowDefinition   WorkflowDefinition     @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  approvalActions      ApprovalAction[]

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status, currentStepSequence])
}

model ApprovalAction {
  id                 String           @id @default(uuid())
  tenantId           String
  workflowInstanceId String
  workflowStepId     String
  actorId            String
  actorRole          String
  decision           ApprovalDecision
  comments           String?
  createdAt          DateTime         @default(now())
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict)
  workflowStep       WorkflowStep     @relation(fields: [workflowStepId], references: [id], onDelete: Restrict)

  @@index([tenantId, workflowInstanceId, workflowStepId, decision])
  @@index([tenantId, actorId, createdAt])
}

model EscalationRule {
  id                   String             @id @default(uuid())
  tenantId             String
  workflowDefinitionId String
  workflowStepId       String
  escalateAfterMinutes Int
  escalationRole       String
  action               EscalationAction   @default(NOTIFY)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowStep         WorkflowStep       @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowDefinitionId, workflowStepId, isActive])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String
  entityId   String
  action     String
  actorId    String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId, createdAt])
}

model Portfolio {
  id          String    @id @default(uuid())
  tenantId    String
  code        String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
  programs    Program[]

  @@unique([tenantId, code])
}

model Program {
  id          String    @id @default(uuid())
  tenantId    String
  portfolioId String
  code        String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  projects    Project[]

  @@unique([tenantId, code])
  @@index([tenantId, portfolioId])
}

model Project {
  id                String                 @id @default(uuid())
  tenantId          String
  code              String
  name              String
  description       String?
  projectManagerId  String
  sponsorId         String?
  programId         String?
  portfolioId       String
  lifecycleStatus   ProjectLifecycleStatus @default(DRAFT)
  currentPhaseCode  String
  plannedStartDate  DateTime
  plannedEndDate    DateTime
  actualStartDate   DateTime?
  actualEndDate     DateTime?
  plannedBudget     Decimal                @db.Decimal(18, 2)
  forecastCost      Decimal?               @db.Decimal(18, 2)
  actualCost        Decimal?               @db.Decimal(18, 2)
  progressPercent   Decimal                @default(0) @db.Decimal(5, 2)
  scheduleRag       ProjectHealthRag       @default(GREEN)
  costRag           ProjectHealthRag       @default(GREEN)
  overallHealthRag  ProjectHealthRag       @default(GREEN)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  program           Program?               @relation(fields: [programId], references: [id], onDelete: Restrict)
  portfolio         Portfolio              @relation(fields: [portfolioId], references: [id], onDelete: Restrict)
  phaseInstances    ProjectPhaseInstance[]
  gateInstances     ProjectGateInstance[]
  statusSnapshots   ProjectStatusSnapshot[]
  tasks             Task[]
  milestones        Milestone[]
  baselines         ScheduleBaseline[]

  @@unique([tenantId, code])
  @@index([tenantId, programId, portfolioId])
}

model ProjectPhaseDefinition {
  id              String                 @id @default(uuid())
  tenantId        String
  code            String
  name            String
  sequence        Int
  isMandatory     Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  gateDefinitions ProjectGateDefinition[]
  phaseInstances  ProjectPhaseInstance[]

  @@unique([tenantId, code])
  @@unique([tenantId, sequence])
}

model ProjectPhaseInstance {
  id                String                 @id @default(uuid())
  tenantId          String
  projectId         String
  phaseDefinitionId String
  status            ProjectLifecycleStatus @default(DRAFT)
  enteredAt         DateTime               @default(now())
  exitedAt          DateTime?
  project           Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseDefinition   ProjectPhaseDefinition @relation(fields: [phaseDefinitionId], references: [id], onDelete: Restrict)

  @@index([tenantId, projectId, phaseDefinitionId])
}

model ProjectGateDefinition {
  id                String                 @id @default(uuid())
  tenantId          String
  phaseDefinitionId String
  code              String
  name              String
  sequence          Int
  workflowCode      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  phaseDefinition   ProjectPhaseDefinition @relation(fields: [phaseDefinitionId], references: [id], onDelete: Cascade)
  gateInstances     ProjectGateInstance[]

  @@unique([tenantId, code])
  @@index([tenantId, phaseDefinitionId, sequence])
}

model ProjectGateInstance {
  id               String         @id @default(uuid())
  tenantId         String
  projectId        String
  gateDefinitionId String
  decision         GateDecision   @default(PENDING)
  dueAt            DateTime?
  decidedAt        DateTime?
  decidedBy        String?
  workflowInstanceId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gateDefinition   ProjectGateDefinition @relation(fields: [gateDefinitionId], references: [id], onDelete: Restrict)

  @@index([tenantId, projectId, decision])
}

model ProjectStatusSnapshot {
  id                      String           @id @default(uuid())
  tenantId                String
  projectId               String
  reportingDate           DateTime
  progressPercent         Decimal          @db.Decimal(5, 2)
  scheduleVariancePercent Decimal          @db.Decimal(5, 2)
  costVariancePercent     Decimal          @db.Decimal(5, 2)
  scheduleRag             ProjectHealthRag
  costRag                 ProjectHealthRag
  overallHealthRag        ProjectHealthRag
  createdAt               DateTime         @default(now())
  project                 Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, reportingDate])
}

model ProjectExcelJob {
  id            String       @id @default(uuid())
  tenantId      String
  projectId     String?
  operation     String
  status        ExcelJobStatus @default(CREATED)
  fileName      String
  resultSummary Json?
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, operation, status, createdAt])
}

model Task {
  id                 String      @id @default(uuid())
  tenantId           String
  projectId          String
  parentTaskId       String?
  wbsCode            String
  name               String
  description        String?
  status             TaskStatus  @default(NOT_STARTED)
  plannedStartDate   DateTime
  plannedEndDate     DateTime
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  plannedEffortHours Decimal     @default(0) @db.Decimal(10, 2)
  actualEffortHours  Decimal     @default(0) @db.Decimal(10, 2)
  progressPercent    Decimal     @default(0) @db.Decimal(5, 2)
  weight             Decimal     @default(1) @db.Decimal(8, 2)
  expectedProgressPercent Decimal @default(0) @db.Decimal(5, 2)
  isMilestone        Boolean     @default(false)
  msProjectTaskUid   Int?
  msProjectOutlineNumber String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  project            Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask         Task?       @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Restrict)
  children           Task[]      @relation("TaskHierarchy")
  predecessors       TaskDependency[] @relation("TaskDependencySuccessor")
  successors         TaskDependency[] @relation("TaskDependencyPredecessor")
  progressEntries    TaskProgressEntry[]
  baselines          ScheduleBaseline[]

  @@unique([tenantId, projectId, wbsCode])
  @@index([tenantId, projectId, parentTaskId])
}

model Milestone {
  id                 String    @id @default(uuid())
  tenantId           String
  projectId          String
  taskId             String?
  code               String
  name               String
  plannedDate        DateTime
  actualDate         DateTime?
  isAchieved         Boolean   @default(false)
  msProjectTaskUid   Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task               Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([tenantId, projectId, code])
  @@index([tenantId, projectId, plannedDate])
}

model TaskDependency {
  id                  String         @id @default(uuid())
  tenantId            String
  projectId           String
  predecessorTaskId   String
  successorTaskId     String
  dependencyType      DependencyType @default(FS)
  lagDays             Int            @default(0)
  msProjectLinkUid    Int?
  createdAt           DateTime       @default(now())
  predecessorTask     Task           @relation("TaskDependencyPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successorTask       Task           @relation("TaskDependencySuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([tenantId, predecessorTaskId, successorTaskId, dependencyType])
  @@index([tenantId, projectId])
}

model ScheduleBaseline {
  id                     String        @id @default(uuid())
  tenantId               String
  projectId              String
  taskId                 String?
  scope                  BaselineScope
  baselineKind           BaselineKind  @default(UPDATED)
  baselineVersion        Int
  baselineDate           DateTime      @default(now())
  plannedStartDate       DateTime
  plannedEndDate         DateTime
  plannedEffortHours     Decimal?      @db.Decimal(10, 2)
  plannedCost            Decimal?      @db.Decimal(18, 2)
  progressPercentAtSave  Decimal?      @db.Decimal(5, 2)
  createdBy              String
  createdAt              DateTime      @default(now())
  project                Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                   Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, baselineVersion, scope])
  @@index([tenantId, projectId, baselineKind, scope])
}

/// Deterministic schedule roll-up facts for dashboards (Program / Portfolio / Enterprise).
model ScheduleRollupSnapshot {
  id                         String              @id @default(uuid())
  tenantId                   String
  objectType                 FinancialObjectType
  objectId                   String
  reportingPeriod            String
  asOfDate                   DateTime            @default(now())
  actualProgressPercent      Decimal             @db.Decimal(5, 2)
  expectedProgressPercent    Decimal             @db.Decimal(5, 2)
  scheduleVariancePercent    Decimal             @db.Decimal(5, 2)
  scheduleRag                ProjectHealthRag
  includedProjectCount       Int                 @default(0)
  leafTaskCount              Int                 @default(0)
  computedAt                 DateTime            @default(now())

  @@index([tenantId, objectType, objectId, reportingPeriod, computedAt])
}

model TaskProgressEntry {
  id               String    @id @default(uuid())
  tenantId         String
  taskId           String
  progressDate     DateTime  @default(now())
  progressPercent  Decimal   @db.Decimal(5, 2)
  actualEffortHours Decimal? @db.Decimal(10, 2)
  notes            String?
  createdBy        String
  createdAt        DateTime  @default(now())
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId, taskId, progressDate])
}

model ScheduleExcelJob {
  id            String       @id @default(uuid())
  tenantId      String
  projectId     String
  operation     String
  status        ExcelJobStatus @default(CREATED)
  fileName      String
  rowCount      Int          @default(0)
  payloadJson   Json?
  resultSummary Json?
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, projectId, operation, status, createdAt])
}

/// Microsoft Project (.mpp / MSPDI XML) integration jobs with audit + confirmation gates.
model ScheduleMppJob {
  id                String         @id @default(uuid())
  tenantId          String
  projectId         String
  operation         String
  status            ExcelJobStatus @default(CREATED)
  /// MPP_BINARY | MSPDI_XML
  sourceFormat      String
  fileName          String
  /// STRICT_APPEND | REPLACE_SCHEDULE — captured at validation time for commit enforcement.
  mergeMode         String?
  payloadJson       Json?
  validationReport  Json?
  resultSummary     Json?
  confirmedAt       DateTime?
  confirmedBy       String?
  createdBy         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([tenantId, projectId, operation, status, createdAt])
}

model ResourceRole {
  id                 String           @id @default(uuid())
  tenantId           String
  code               String
  name               String
  description        String?
  defaultRate        Decimal?         @db.Decimal(18, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  resources          Resource[]
  capacityPlans      CapacityPlan[]
  allocations        ResourceAllocation[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

model Skill {
  id                 String           @id @default(uuid())
  tenantId           String
  code               String
  name               String
  category           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  resourceSkills     ResourceSkill[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
}

model Resource {
  id                 String           @id @default(uuid())
  tenantId           String
  code               String
  name               String
  type               ResourceType
  status             ResourceStatus   @default(ACTIVE)
  roleId             String?
  managerId          String?
  email              String?
  location           String?
  standardCapacityHoursPerDay Decimal @default(8) @db.Decimal(6, 2)
  overAllocationThresholdPercent Decimal @default(100) @db.Decimal(5, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  role               ResourceRole?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  skills             ResourceSkill[]
  capacityPlans      CapacityPlan[]
  allocations        ResourceAllocation[]

  @@unique([tenantId, code])
  @@index([tenantId, type, status, roleId])
}

model ResourceSkill {
  id                 String           @id @default(uuid())
  tenantId           String
  resourceId         String
  skillId            String
  proficiencyLevel   Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  resource           Resource         @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([tenantId, resourceId, skillId])
  @@index([tenantId, skillId, proficiencyLevel])
}

model CapacityPlan {
  id                 String           @id @default(uuid())
  tenantId           String
  resourceId         String?
  roleId             String?
  periodStart        DateTime
  periodEnd          DateTime
  availableHours     Decimal          @db.Decimal(10, 2)
  thresholdPercent   Decimal          @default(100) @db.Decimal(5, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  resource           Resource?        @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  role               ResourceRole?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([tenantId, resourceId, roleId, periodStart, periodEnd])
}

model ResourceAllocation {
  id                 String           @id @default(uuid())
  tenantId           String
  resourceId         String?
  roleId             String?
  objectType         String
  objectId           String
  startDate          DateTime
  endDate            DateTime
  allocationPercent  Decimal          @db.Decimal(5, 2)
  plannedHours       Decimal          @db.Decimal(10, 2)
  approvedHours      Decimal?         @db.Decimal(10, 2)
  status             AllocationStatus @default(DRAFT)
  workflowInstanceId String?
  requestedBy        String
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  resource           Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  role               ResourceRole?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([tenantId, resourceId, roleId, objectType, objectId, startDate, endDate])
  @@index([tenantId, status])
}

model ResourceExcelJob {
  id                 String           @id @default(uuid())
  tenantId           String
  operation          String
  entityName         String
  status             ExcelJobStatus   @default(CREATED)
  fileName           String
  rowCount           Int              @default(0)
  payloadJson        Json?
  resultSummary      Json?
  createdBy          String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([tenantId, entityName, operation, status, createdAt])
}

model FinancialBudget {
  id                 String             @id @default(uuid())
  tenantId           String
  objectType         FinancialObjectType
  objectId           String
  fiscalPeriod       String
  category           BudgetCategory
  plannedAmount      Decimal            @db.Decimal(18, 2)
  approvedAmount     Decimal            @db.Decimal(18, 2)
  committedAmount    Decimal            @default(0) @db.Decimal(18, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  baselines          FinancialBudgetBaseline[]
  forecasts          FinancialForecast[]
  actuals            FinancialActualCost[]

  @@index([tenantId, objectType, objectId, fiscalPeriod, category])
}

model FinancialBudgetBaseline {
  id                 String             @id @default(uuid())
  tenantId           String
  budgetId           String
  baselineVersion    Int
  baselineAmount     Decimal            @db.Decimal(18, 2)
  approvedBy         String
  approvedAt         DateTime           @default(now())
  createdAt          DateTime           @default(now())
  budget             FinancialBudget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([tenantId, budgetId, baselineVersion])
  @@index([tenantId, approvedAt])
}

model FinancialForecast {
  id                 String             @id @default(uuid())
  tenantId           String
  budgetId           String
  forecastPeriod     String
  estimateToComplete Decimal            @db.Decimal(18, 2)
  estimateAtCompletion Decimal          @db.Decimal(18, 2)
  notes              String?
  createdBy          String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  budget             FinancialBudget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([tenantId, budgetId, forecastPeriod])
}

model FinancialActualCost {
  id                 String             @id @default(uuid())
  tenantId           String
  budgetId           String
  postingPeriod      String
  postingDate        DateTime
  amount             Decimal            @db.Decimal(18, 2)
  sourceReference    String?
  createdBy          String
  createdAt          DateTime           @default(now())
  budget             FinancialBudget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([tenantId, budgetId, postingPeriod, postingDate])
}

model FinancialSummary {
  id                 String             @id @default(uuid())
  tenantId           String
  objectType         FinancialObjectType
  objectId           String
  period             String
  totalApprovedBudget Decimal           @db.Decimal(18, 2)
  totalForecastEac   Decimal            @db.Decimal(18, 2)
  totalActualCost    Decimal            @db.Decimal(18, 2)
  costVariance       Decimal            @db.Decimal(18, 2)
  costVariancePercent Decimal           @db.Decimal(7, 2)
  ragStatus          FinancialAlertRag
  computedAt         DateTime           @default(now())

  @@index([tenantId, objectType, objectId, period, computedAt])
}

model FinancialAlert {
  id                 String             @id @default(uuid())
  tenantId           String
  objectType         FinancialObjectType
  objectId           String
  period             String
  metric             String
  thresholdGreen     Decimal            @db.Decimal(7, 2)
  thresholdAmber     Decimal            @db.Decimal(7, 2)
  thresholdRed       Decimal            @db.Decimal(7, 2)
  actualValue        Decimal            @db.Decimal(18, 2)
  ragStatus          FinancialAlertRag
  createdAt          DateTime           @default(now())

  @@index([tenantId, objectType, objectId, period, ragStatus])
}

model FinancialExcelJob {
  id                 String             @id @default(uuid())
  tenantId           String
  operation          String
  entityName         String
  status             ExcelJobStatus     @default(CREATED)
  fileName           String
  rowCount           Int                @default(0)
  payloadJson        Json?
  resultSummary      Json?
  createdBy          String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, entityName, operation, status, createdAt])
}

model Risk {
  id                 String             @id @default(uuid())
  tenantId           String
  objectType         FinancialObjectType
  objectId           String
  title              String
  description        String?
  category           String?
  probability        Decimal            @db.Decimal(5, 2)
  impact             Decimal            @db.Decimal(5, 2)
  severity           SeverityLevel
  severityWeight     Decimal            @db.Decimal(5, 2)
  exposureScore      Decimal            @db.Decimal(10, 2)
  ownerId            String
  reviewDate         DateTime?
  status             RecordStatus       @default(OPEN)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  actions            RiskIssueAction[]

  @@index([tenantId, objectType, objectId, severity, status])
}

model Issue {
  id                 String             @id @default(uuid())
  tenantId           String
  objectType         FinancialObjectType
  objectId           String
  title              String
  description        String?
  severity           SeverityLevel
  ownerId            String
  status             RecordStatus       @default(OPEN)
  openedAt           DateTime           @default(now())
  targetResolutionDate DateTime?
  resolvedAt         DateTime?
  agingDays          Int                @default(0)
  escalationSlaDays  Int                @default(7)
  isEscalated        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  actions            RiskIssueAction[]

  @@index([tenantId, objectType, objectId, severity, status, isEscalated])
}

model ChangeRequest {
  id                 String             @id @default(uuid())
  tenantId           String
  objectType         FinancialObjectType
  objectId           String
  title              String
  description        String?
  requestedBy        String
  status             RecordStatus       @default(OPEN)
  scopeImpact        Decimal            @default(0) @db.Decimal(10, 2)
  scheduleImpactDays Int                @default(0)
  costImpact         Decimal            @default(0) @db.Decimal(18, 2)
  resourceImpactHours Decimal           @default(0) @db.Decimal(10, 2)
  workflowInstanceId String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, objectType, objectId, status])
}

model RiskIssueAction {
  id                 String             @id @default(uuid())
  tenantId           String
  actionType         ActionType
  riskId             String?
  issueId            String?
  title              String
  ownerId            String
  dueDate            DateTime?
  status             RecordStatus       @default(OPEN)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  risk               Risk?              @relation(fields: [riskId], references: [id], onDelete: Cascade)
  issue              Issue?             @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([tenantId, actionType, status, dueDate])
}

model RicRollupSummary {
  id                 String             @id @default(uuid())
  tenantId           String
  objectType         FinancialObjectType
  objectId           String
  period             String
  riskExposureTotal  Decimal            @db.Decimal(18, 2)
  issueWeightedTotal Decimal            @db.Decimal(18, 2)
  criticalCount      Int                @default(0)
  highCount          Int                @default(0)
  mediumCount        Int                @default(0)
  lowCount           Int                @default(0)
  computedAt         DateTime           @default(now())

  @@index([tenantId, objectType, objectId, period, computedAt])
}

model RicExcelJob {
  id                 String             @id @default(uuid())
  tenantId           String
  operation          String
  entityName         String
  status             ExcelJobStatus     @default(CREATED)
  fileName           String
  rowCount           Int                @default(0)
  payloadJson        Json?
  resultSummary      Json?
  createdBy          String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, entityName, operation, status, createdAt])
}

/// AI/rule-assisted detection queue — never auto-published as registered risks.
enum DetectedRiskSuggestionStatus {
  PROPOSED
  UNDER_REVIEW
  PUBLISHED
  DISMISSED
}

model RiskDetectionRun {
  id              String                      @id @default(uuid())
  tenantId        String
  scopeType       FinancialObjectType
  scopeId         String
  periodLabel     String
  metricsSnapshot Json
  factsDigest     String
  createdBy       String
  createdAt       DateTime                    @default(now())
  suggestions     DetectedRiskSuggestion[]

  @@index([tenantId, scopeType, scopeId, createdAt])
  @@index([tenantId, periodLabel])
}

model DetectedRiskSuggestion {
  id                  String                       @id @default(uuid())
  runId               String
  tenantId            String
  objectType          FinancialObjectType
  objectId            String
  signalCode          String
  title               String
  descriptionDraft    String?
  category            String?
  probability         Decimal                      @db.Decimal(5, 2)
  impact              Decimal                      @db.Decimal(5, 2)
  severity            SeverityLevel
  severityWeight      Decimal                      @db.Decimal(5, 2)
  exposureScore       Decimal                      @db.Decimal(10, 2)
  confidenceScore     Decimal                      @db.Decimal(5, 2)
  mitigationDraft     String?
  evidenceJson        Json
  aiExplanationJson   Json
  proposedOwnerId     String
  status              DetectedRiskSuggestionStatus @default(PROPOSED)
  workflowInstanceId  String?
  publishedRiskId     String?
  reviewerNotes       String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  run                 RiskDetectionRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, objectType, objectId])
  @@index([tenantId, signalCode])
}

enum WeeklyStatusReportStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
}

enum WeeklyStatusExportFormat {
  XLSX
  PDF
  PPTX
}

model WeeklyStatusReport {
  id                  String                     @id @default(uuid())
  tenantId            String
  scopeType           FinancialObjectType
  scopeId             String
  reportingWeek       String
  fiscalPeriod        String
  status              WeeklyStatusReportStatus     @default(DRAFT)
  publishedAt         DateTime?
  publishedBy         String?
  publishedRevisionId String?                    @unique
  workflowInstanceId  String?
  pendingPublishRevisionId String?
  createdBy           String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  publishedRevision   WeeklyStatusReportRevision? @relation("PublishedRevisionLink", fields: [publishedRevisionId], references: [id])
  revisions           WeeklyStatusReportRevision[] @relation("ReportRevisions")
  exports             WeeklyStatusReportExportJob[]

  @@unique([tenantId, scopeType, scopeId, reportingWeek])
  @@index([tenantId, status, reportingWeek])
  @@index([tenantId, workflowInstanceId])
}

model WeeklyStatusReportRevision {
  id               String              @id @default(uuid())
  reportId         String
  revisionNumber   Int
  metricsSnapshot  Json
  aiProposal       Json
  editorContent    Json
  createdBy        String
  createdAt        DateTime            @default(now())
  report           WeeklyStatusReport  @relation("ReportRevisions", fields: [reportId], references: [id], onDelete: Cascade)
  linkedAsPublished WeeklyStatusReport? @relation("PublishedRevisionLink")
  exports          WeeklyStatusReportExportJob[]

  @@unique([reportId, revisionNumber])
  @@index([reportId, revisionNumber])
}

model WeeklyStatusReportExportJob {
  id             String                   @id @default(uuid())
  tenantId       String
  reportId       String
  revisionId     String
  format         WeeklyStatusExportFormat
  status         ExcelJobStatus             @default(COMPLETED)
  fileName       String
  resultSummary  Json?
  createdBy      String
  createdAt      DateTime                   @default(now())
  report         WeeklyStatusReport         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  revision       WeeklyStatusReportRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([tenantId, reportId, createdAt])
}
